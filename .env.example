# JP Wilson Financial Group — Environment Variables
# No env vars required for lead capture.
# Jotform form ID is hardcoded (261496542238059).
# All leads go directly to Jotform → configure Zapier from there.

# Optional: add any future server-side vars here

# Analytics, all optional. Leave blank to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional scheduling CTA shown only after a successful lead submission.
NEXT_PUBLIC_BOOKING_URL=

# Optional controlled fallback intake used only if Jotform does not accept a lead.
# The endpoint must durably store or notify the lead before returning 2xx.
LEAD_FALLBACK_WEBHOOK_URL=
LEAD_FALLBACK_WEBHOOK_SECRET=

# Optional notification webhook for email/SMS redundancy after a lead is accepted.
LEAD_NOTIFICATION_WEBHOOK_URL=
LEAD_NOTIFICATION_WEBHOOK_SECRET=

# AgencyZoom stays disabled until the account IDs and server-side credentials are verified.
# Use dry-run locally to validate payloads without making any AgencyZoom or Jotform request.
AGENCYZOOM_MODE=disabled
AGENCYZOOM_BEARER_TOKEN=
AGENCYZOOM_USERNAME=
AGENCYZOOM_PASSWORD=
AGENCYZOOM_PIPELINE_ID_AUTO=
AGENCYZOOM_STAGE_ID_AUTO=
AGENCYZOOM_PIPELINE_ID_LIFE=
AGENCYZOOM_STAGE_ID_LIFE=
AGENCYZOOM_PIPELINE_ID_COMMERCIAL=
AGENCYZOOM_STAGE_ID_COMMERCIAL=
AGENCYZOOM_LEAD_SOURCE_ID=
AGENCYZOOM_ASSIGN_TO=
# Optional per-funnel overrides for the shared source/assignee values above.
AGENCYZOOM_LEAD_SOURCE_ID_AUTO=
AGENCYZOOM_ASSIGN_TO_AUTO=
AGENCYZOOM_LEAD_SOURCE_ID_LIFE=
AGENCYZOOM_ASSIGN_TO_LIFE=
AGENCYZOOM_LEAD_SOURCE_ID_COMMERCIAL=
AGENCYZOOM_ASSIGN_TO_COMMERCIAL=
# These values are AgencyZoom custom-field names, configured in the account.
AGENCYZOOM_CF_LEAD_ID=
AGENCYZOOM_CF_FUNNEL_ID=
AGENCYZOOM_CF_FUNNEL_VERSION=
AGENCYZOOM_CF_CAMPAIGN_ID=
AGENCYZOOM_CF_CONTENT_ID=
AGENCYZOOM_CF_AD_ID=
AGENCYZOOM_CF_BATCH_ID=

# First-party CAPS event ingestion. Legacy JP_AUTO_* names remain supported during migration.
JP_FUNNEL_TELEMETRY_URL=
JP_FUNNEL_TELEMETRY_SECRET=
NEXT_PUBLIC_AUTO_BOOKING_URL=
