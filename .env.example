# Patrick Wilson Financial — Environment Variables
# No env vars required for lead capture.
# Jotform form ID is hardcoded (261496542238059).
# All leads go directly to Jotform → configure Zapier from there.

# Optional: add any future server-side vars here

# Analytics, all optional. Leave blank to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional scheduling CTA shown only after a successful lead submission.
NEXT_PUBLIC_BOOKING_URL=

# Optional controlled fallback intake used only if Jotform does not accept a lead.
# The endpoint must durably store or notify the lead before returning 2xx.
LEAD_FALLBACK_WEBHOOK_URL=
LEAD_FALLBACK_WEBHOOK_SECRET=

# Optional notification webhook for email/SMS redundancy after a lead is accepted.
LEAD_NOTIFICATION_WEBHOOK_URL=
LEAD_NOTIFICATION_WEBHOOK_SECRET=
